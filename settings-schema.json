{
    "layout1": {
        "type": "layout",
        "pages": ["general", "appearance", "content"],
        "general": {
            "type": "page",
            "title": "General / Geral",
            "sections": ["general-lang-search", "general-behavior"]
        },
        "appearance": {
            "type": "page",
            "title": "Appearance / Aparência",
            "sections": ["appearance-panel", "appearance-menu"]
        },
        "content": {
            "type": "page",
            "title": "Content / Conteúdo",
            "sections": ["content-sections", "content-places"]
        },
        "general-lang-search": {
            "type": "section",
            "title": "Language and Search Button / Idioma e Botão de Pesquisa",
            "keys": ["language", "search-display", "search-button-size-mode", "search-pill-height", "search-button-spacing"]
        },
        "general-behavior": {
            "type": "section",
            "title": "Behavior / Comportamento",
            "keys": ["sync-instances", "overlay-key", "center-menu-on-screen", "activate-on-hover", "hover-delay", "enable-animation", "enable-autoscroll"]
        },
        "appearance-panel": {
            "type": "section",
            "title": "Panel Icon / Ícone do Painel",
            "keys": ["menu-custom", "menu-icon", "menu-icon-size-mode", "menu-icon-size", "menu-label"]
        },
        "appearance-menu": {
            "type": "section",
            "title": "Menu Options / Opções do Menu",
            "keys": ["menu-size", "custom-menu-width", "custom-menu-height", "show-description", "reset-pinned-button"]
        },
        "content-sections": {
            "type": "section",
            "title": "Menu Content / Conteúdo do Menu",
            "keys": ["show-avatar", "show-all-apps", "show-recent-apps", "show-recent-files", "menu-editor-button"]
        },
        "content-places": {
            "type": "section",
            "title": "Footer Quick Places / Atalhos na Barra Inferior",
            "keys": ["show-files", "show-settings", "show-downloads", "show-documents", "show-pictures", "show-music", "show-videos", "show-network", "show-home"]
        }
    },
    "language": {
        "type": "combobox",
        "default": "en",
        "description": "Language / Língua",
        "options": {
            "English (Default)": "en",
            "Português (Brasil) - PT-BR": "ptbr"
        }
    },
    "search-display": {
        "type": "combobox",
        "default": "pill",
        "description": "Taskbar search / Pesquisa na barra de tarefas",
        "options": {
            "Hide / Ocultar": "hidden",
            "Search icon only / Somente ícone de pesquisa": "icon",
            "Search icon and label / Ícone e rótulo de pesquisa": "pill",
            "Search box / Caixa de pesquisa": "box"
        }
    },
    "show-search-button": {
        "type": "generic",
        "default": true
    },
    "search-button-style": {
        "type": "generic",
        "default": "pill"
    },
    "show-recents": {
        "type": "generic",
        "default": true
    },
    "settings-version": {
        "type": "generic",
        "default": 1
    },
    "show-all-apps": {
        "type": "switch",
        "default": true,
        "description": "All / Tudo",
        "tooltip": "Show all apps and system components / Mostrar todos os aplicativos e componentes do sistema"
    },
    "show-recent-apps": {
        "type": "switch",
        "default": true,
        "description": "Show recently added apps / Mostrar aplicativos adicionados recentemente"
    },
    "show-recent-files": {
        "type": "switch",
        "default": true,
        "description": "Show recent files / Mostrar arquivos recentes",
        "tooltip": "Uses actual file history and respects Cinnamon's privacy setting; disabling files keeps recent apps visible / Usa o histórico real e respeita a privacidade do Cinnamon; desativar arquivos mantém os aplicativos recentes visíveis"
    },
    "search-button-size-mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Search button size / Tamanho do botão de pesquisa",
        "options": {
            "Automatic (adapt to panel height) / Automático (ajustar à barra de tarefas)": "auto",
            "Custom height / Altura personalizada": "custom"
        }
    },
    "search-pill-height": {
        "type": "spinbutton",
        "default": 30,
        "min": 20,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Custom search button height / Altura personalizada do botão",
        "dependency": "search-button-size-mode=custom"
    },
    "search-button-spacing": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Extra spacing on both sides of Search / Espaçamento extra dos dois lados da pesquisa",
        "tooltip": "Adds the same space between Menu and Search and between Search and the next applet. 0 keeps the current minimum. Applies immediately. / Acrescenta o mesmo espaço entre Menu e Pesquisa e entre Pesquisa e o próximo miniaplicativo. 0 mantém o mínimo atual. Aplicação imediata.",
        "dependency": "search-display!=hidden"
    },
    "overlay-key": {
        "type": "keybinding",
        "description": "Keyboard shortcut to open and close the menu / Atalho de teclado para abrir e fechar o menu",
        "default": "Super_L::Super_R"
    },
    "center-menu-on-screen": {
        "type": "switch",
        "default": true,
        "description": "Center menu horizontally on screen (Windows 11 style) / Centralizar menu horizontalmente na tela (estilo Windows 11)"
    },
    "menu-custom": {
        "type": "switch",
        "default": true,
        "description": "Use a custom icon and label / Usar ícone e texto personalizados"
    },
    "menu-icon": {
        "type": "iconfilechooser",
        "default": "linuxmint-logo-ring-symbolic",
        "description": "Start button icon / Ícone do botão Iniciar",
        "tooltip": "Choose a themed icon or browse for a local image file in the native Cinnamon icon chooser. / Escolha um ícone do tema ou procure uma imagem local no seletor nativo do Cinnamon.",
        "default_icon": "linuxmint-logo-ring-symbolic",

        "icon_categories": [
            {
                "name": "Linux Mint",
                "icons": [
                    "linuxmint-logo",
                    "linuxmint-logo-badge",
                    "linuxmint-logo-badge-symbolic",
                    "linuxmint-logo-filled-badge",
                    "linuxmint-logo-filled-leaf-badge",
                    "linuxmint-logo-filled-leaf",
                    "linuxmint-logo-filled-ring",
                    "linuxmint-logo-leaf-badge",
                    "linuxmint-logo-leaf-badge-symbolic",
                    "linuxmint-logo-leaf",
                    "linuxmint-logo-leaf-symbolic",
                    "linuxmint-logo-neon",
                    "linuxmint-logo-ring",
                    "linuxmint-logo-ring-symbolic",
                    "linuxmint-logo-simple",
                    "linuxmint-logo-simple-symbolic",
                    "cinnamon-symbolic",
                    "emblem-favorite-symbolic",
                    "user-bookmarks-symbolic",
                    "start-here-symbolic"
                ]
            }
        ],
        "dependency": "menu-custom"
    },
    "menu-icon-size-mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Menu icon size / Tamanho do ícone do menu",
        "dependency": "menu-custom",
        "options": {
            "Automatic (adapt to panel height) / Automático (ajustar à barra de tarefas)": "auto",
            "Custom size / Personalizado": "custom"
        }
    },
    "menu-icon-size": {
        "type": "spinbutton",
        "default": 32,
        "min": 16,
        "max": 96,
        "step": 1,
        "units": "px",
        "description": "Custom icon size / Tamanho personalizado do ícone",
        "dependency": "menu-icon-size-mode=custom"
    },
    "menu-label": {
        "type": "entry",
        "default": "",
        "description": "Panel Text / Texto no painel",
        "dependency": "menu-custom"
    },
    "icon-size-mode": {
        "type": "generic",
        "default": "standard"
    },
    "menu-size": {
        "type": "combobox",
        "default": "large",
        "description": "Menu size / Tamanho do menu",
        "tooltip": "Applies immediately. Menu bounds adapt proportionally to the monitor and available area; in Custom mode you can also drag the top-right corner of the menu. / Aplicação imediata. As dimensões do menu se ajustam proporcionalmente ao monitor e à área disponível; no modo Personalizado você também pode arrastar o canto superior direito do menu.",
        "options": {
            "Small / Pequeno": "small",
            "Medium / Médio": "medium",
            "Large / Grande": "large",
            "Custom / Personalizado": "custom"
        }
    },
    "custom-menu-width": {
        "type": "spinbutton",
        "default": 738,
        "min": 400,
        "max": 3840,
        "step": 1,
        "units": "px",
        "description": "Menu width / Largura do menu",
        "dependency": "menu-size=custom"
    },
    "custom-menu-height": {
        "type": "spinbutton",
        "default": 796,
        "min": 400,
        "max": 2160,
        "step": 1,
        "units": "px",
        "description": "Menu height / Altura do menu",
        "dependency": "menu-size=custom"
    },
    "show-avatar": {
        "type": "switch",
        "default": true,
        "description": "Show user avatar and name / Mostrar avatar e nome do usuário"
    },
    "show-description": {
        "type": "switch",
        "default": true,
        "description": "Show application descriptions in search / Mostrar descrições na pesquisa"
    },
    "show-files": {
        "type": "switch",
        "default": true,
        "description": "File Explorer / Explorador de Arquivos"
    },
    "show-settings": {
        "type": "switch",
        "default": true,
        "description": "System Settings / Configurações do Sistema"
    },
    "show-downloads": {
        "type": "switch",
        "default": true,
        "description": "Downloads"
    },
    "show-documents": {
        "type": "switch",
        "default": true,
        "description": "Documents / Documentos"
    },
    "show-pictures": {
        "type": "switch",
        "default": true,
        "description": "Pictures / Imagens"
    },
    "show-music": {
        "type": "switch",
        "default": false,
        "description": "Music / Música"
    },
    "show-videos": {
        "type": "switch",
        "default": false,
        "description": "Videos / Vídeos"
    },
    "show-home": {
        "type": "switch",
        "default": true,
        "description": "Personal folder (Home) / Pasta pessoal"
    },
    "show-network": {
        "type": "switch",
        "default": false,
        "description": "Network / Rede"
    },
    "sync-instances": {
        "type": "switch",
        "default": true,
        "description": "Sync menus across multiple monitors / Sincronizar menus entre múltiplos monitores",
        "tooltip": "Keeps pinned apps, recents, order, and settings identical across all instances of this applet / Mantém aplicativos fixados, recentes, ordem e configurações idênticos em todas as instâncias deste applet"
    },
    "enable-autoscroll": {
        "type": "switch",
        "default": true,
        "description": "Enable autoscrolling in application list / Rolagem automática na lista"
    },
    "activate-on-hover": {
        "type": "switch",
        "default": false,
        "description": "Open the menu when I move my mouse over it / Abrir ao passar o mouse"
    },
    "hover-delay": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 1000,
        "step": 50,
        "units": "milliseconds",
        "dependency": "activate-on-hover",
        "description": "Menu hover delay / Atraso ao passar o mouse"
    },
    "enable-animation": {
        "type": "switch",
        "default": true,
        "description": "Use menu animations / Usar animações no menu"
    },
    "menu-editor-button": {
        "type": "button",
        "description": "Open the menu editor / Abrir editor do menu",
        "callback": "_launch_editor"
    },

    "reset-pinned-button": {
        "type": "button",
        "description": "Reset pinned apps to default / Restaurar aplicativos fixados padrão",
        "callback": "_reset_pinned_apps"
    },

    "pinned-items": {
        "type": "generic",
        "default": []
    },
    "pinned-expanded": {
        "type": "generic",
        "default": true
    },
    "all-apps-view-mode": {
        "type": "generic",
        "default": "list"
    },
    "recent-apps": {
        "type": "generic",
        "default": []
    }
}
